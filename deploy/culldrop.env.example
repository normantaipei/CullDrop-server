CULLDROP_DATA=/srv/culldrop
CULLDROP_DEVICE_TOKENS=iphone:change-me-to-a-long-random-token,ipad:another-token
CULLDROP_PUBLIC_URL=https://photos.example.com
CULLDROP_LANG=en
# CULLDROP_SITE_NAME=Photos   # 不填就依語言：返圖 / Photos / 写真
CULLDROP_MIN_FREE_GB=2
CULLDROP_MAX_INFLIGHT=4
# CULLDROP_DEVICE_NETS=192.168.0.0/16,100.64.0.0/10
# CULLDROP_TRUSTED_PROXIES=192.168.1.10   # 反向代理的 IP，封鎖才看得到真實來源
# CULLDROP_NAS_DIR=/mnt/nas    # 用 deploy/setup-nas.sh 設定
