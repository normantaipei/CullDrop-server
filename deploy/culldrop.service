# systemd：複製到 /etc/systemd/system/culldrop.service，環境變數放 /etc/culldrop.env
[Unit]
Description=Culldrop Server（一台多本相簿的返圖伺服器）
After=network-online.target

[Service]
User=culldrop
WorkingDirectory=/opt/culldrop/server
EnvironmentFile=/etc/culldrop.env
ExecStart=/opt/culldrop/server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --no-proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
